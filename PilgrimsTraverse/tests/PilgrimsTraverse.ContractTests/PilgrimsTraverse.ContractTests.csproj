<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>PilgrimsTraverse.ContractTests</AssemblyName>
  </PropertyGroup>
  <PropertyGroup>
    <DalamudLibPath Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(appdata)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
    <DalamudLibPath Condition="Exists('$(appdata)\XIVLauncherCN\addon\Hooks\dev\')">$(appdata)\XIVLauncherCN\addon\Hooks\dev\</DalamudLibPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\YAxis\YAxisPacketAdjustment.cs" Link="YAxisPacketAdjustment.cs" />
    <Compile Include="..\..\Telemetry\CommunityEvidenceCollector.cs" Link="CommunityEvidenceCollector.cs" />
    <Compile Include="..\..\Telemetry\CommunityLongRunLogCollector.cs" Link="CommunityLongRunLogCollector.cs" />
    <Compile Include="..\..\Telemetry\CommunityUsageTelemetryCollector.cs" Link="CommunityUsageTelemetryCollector.cs" />
    <Compile Include="..\..\Build\PilgrimsTraverseAccessGate.cs" Link="PilgrimsTraverseAccessGate.cs" />
    <Compile Include="..\..\Build\PilgrimsTraverseBuildProfile.cs" Link="PilgrimsTraverseBuildProfile.cs" />
    <ProjectReference Include="..\..\shared\DeepDungeon.Fsd\Core\DeepDungeon.Fsd.Core.csproj" />
    <ProjectReference Include="..\..\shared\DeepDungeon.Fsd\Dalamud\DeepDungeon.Fsd.Dalamud.csproj" />
    <Reference Include="Dalamud"><HintPath>$(DalamudLibPath)Dalamud.dll</HintPath><Private>True</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\PilgrimsTraverse.json" Link="PilgrimsTraverse.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\PilgrimsTraverse-release.json" Link="PilgrimsTraverse-release.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
