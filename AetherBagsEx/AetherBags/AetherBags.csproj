<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <Version>2.0.0.7</Version>
        <AssemblyName>AetherBagsEx</AssemblyName>
        <RootNamespace>AetherBags</RootNamespace>
    </PropertyGroup>

    <PropertyGroup>
        <Author>Zeffuro, Pie Lover</Author>
        <Name>AetherBagsEx</Name>
        <InternalName>AetherBagsEx</InternalName>
        <Punchline>Never think too hard about your bags again!</Punchline>
        <Description>This plugin replaces your inventory with it's own categorified inventory addon.</Description>
        <RepoUrl>https://github.com/Zeffuro/AetherBags</RepoUrl>
        <IconUrl>https://raw.githubusercontent.com/Zeffuro/AetherBags/master/images/icon.png</IconUrl>
        <Tags>inventory;bags;organization;categories;filters;sorting;qol;ui</Tags>
        <AcceptsFeedback>true</AcceptsFeedback>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\KamiToolKit\KamiToolKit.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="loc\*.json" />
    </ItemGroup>

    <ItemGroup>
      <Content Include=".gitignore" />
      <Content Include="changelog.md">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
        <Content Include="Assets\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Visible>false</Visible>
        </Content>
        <Content Include="Assets\Icons\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Visible>false</Visible>
        </Content>
    </ItemGroup>
</Project>
